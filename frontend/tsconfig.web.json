{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src/**/*", "tests/client*.ts", "tests/**/*.tsx", "tests/setup.ts"]
}
